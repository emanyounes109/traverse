{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "source": "/api/(.*)",
      "dest": "backend/src/main.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}